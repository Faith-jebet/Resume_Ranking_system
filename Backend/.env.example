# ============================================================================
# Backend Environment Configuration Example
# ============================================================================
# Copy this file to .env and replace placeholder values with your actual keys
# Never commit the .env file to version control!

# ── API Configuration ───────────────────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:8000

# ── JWT Authentication ──────────────────────────────────────────────────────
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=your_32_character_secret_key_here

# ── Groq LLM API Key ────────────────────────────────────────────────────────
# Get your API key from: https://console.groq.com/keys
# This should match the key in Agent/.env
GROQ_API_KEY="your_groq_api_key_here"

# ── Google OAuth (Web SSO) ──────────────────────────────────────────────────
# Only needed if you want to enable "Sign in with Google" button
# These are WEB APPLICATION credentials (not Desktop app)
# Currently disabled in UI - can skip for now
GOOGLE_CLIENT_ID=your_google_web_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_web_oauth_client_secret

# ── Optional: Database Configuration ────────────────────────────────────────
# Uncomment to override default SQLite database path
# DB_PATH=./custom_path/resumes.db
