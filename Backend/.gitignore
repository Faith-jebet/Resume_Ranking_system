# Backend-specific gitignore

# Environment variables (CRITICAL!)
.env
.env.local
.env.*.local

# Python virtual environment
venv/
ENV/
env/
.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Database files
*.db
*.sqlite
*.sqlite3
resumes.db

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Test coverage
.coverage
htmlcov/
.pytest_cache/
