# ============================================================================
# Agent Environment Configuration Example
# ============================================================================
# Copy this file to .env and replace placeholder values with your actual keys
# Never commit the .env file to version control!

# ── Groq LLM API Key ────────────────────────────────────────────────────────
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# ── Optional Configuration ──────────────────────────────────────────────────
# Uncomment and modify if needed

# Default model for LLM operations
# GROQ_MODEL="llama-3.3-70b-versatile"

# Sleep duration between pipeline steps (seconds)
# PIPELINE_SLEEP_SECONDS=2
