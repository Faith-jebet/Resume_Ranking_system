# ============================================================================
# Frontend Environment Configuration Example
# ============================================================================
# Copy this file to .env and replace placeholder values
# Never commit the .env file to version control!

# ── Backend API URL ─────────────────────────────────────────────────────────
# Local development
VITE_API_URL=http://localhost:8000

# Production (uncomment and update when deploying)
# VITE_API_URL=https://your-production-backend.com

# ── Google OAuth (Web SSO) ──────────────────────────────────────────────────
# Only needed if you want to enable "Sign in with Google" button
# Currently disabled in UI - can skip for now
GOOGLE_CLIENT_ID=your_google_web_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_web_oauth_client_secret

# Note: In Vite, only variables prefixed with VITE_ are exposed to the browser
# GOOGLE_* variables are not currently used in the frontend
