# ============================================================================
# Root .gitignore for Resume Ranking System
# ============================================================================

# Environment variables (CRITICAL - Never commit these!)
.env
.env.local
.env.*.local
*.env

# Secrets and credentials
credentials.json
token.pickle
token.json
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
ENV/
env/
.venv

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Databases
*.db
*.sqlite
*.sqlite3

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
.DS_Store

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp
